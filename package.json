{
  "name": "pagechime",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pagechime/web",
    "dev:mobile": "npm run start -w @pagechime/mobile",
    "build": "npm run build -w @pagechime/web",
    "build:mobile": "npm run export -w @pagechime/mobile",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prepare:manifest": "python scripts/prepare_manifest.py",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.server.json",
    "test:e2e": "playwright test",
    "check:budget": "node scripts/check-budget.mjs",
    "check": "npm run typecheck && npm test && node scripts/validate-docs.mjs --strict-project && node scripts/validate-agent-stack.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "esbuild": "^0.25.12",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
